{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saved competitor sitemap snapshot",
  "description": "Shape of sitemap_snapshot.py output. Runtime checks also enforce same-host public-domain URLs, bounded input, unique URLs, valid dates and consistent completeness. No URL is fetched.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_sitemap", "observation_time", "xml_sha256", "capture_status", "complete", "limitations", "urls"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "source_sitemap": {"type": "string", "format": "uri", "maxLength": 4096},
    "observation_time": {"type": "string", "format": "date-time", "maxLength": 80},
    "xml_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capture_status": {"enum": ["complete_urlset", "partial_urlset", "unresolved_index"]},
    "complete": {"type": "boolean"},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "urls": {
      "type": "array", "maxItems": 50000,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["url"],
        "properties": {
          "url": {"type": "string", "format": "uri", "maxLength": 4096},
          "lastmod": {"type": "string", "minLength": 1, "maxLength": 80}
        }
      }
    },
    "index_children": {"type": "array", "maxItems": 50000, "uniqueItems": true, "items": {"type": "string", "format": "uri", "maxLength": 4096}}
  },
  "allOf": [
    {
      "if": {"properties": {"capture_status": {"const": "complete_urlset"}}},
      "then": {"properties": {"complete": {"const": true}}},
      "else": {"properties": {"complete": {"const": false}}}
    },
    {
      "if": {"properties": {"capture_status": {"const": "unresolved_index"}}},
      "then": {"required": ["index_children"], "properties": {"urls": {"maxItems": 0}}},
      "else": {"not": {"required": ["index_children"]}}
    }
  ]
}
